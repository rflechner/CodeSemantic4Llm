<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codesemantic4llm</ToolCommandName>
    <PackageId>CodeSemantic4Llm.Mcp.Server</PackageId>
    <Version>0.1.2</Version>
    <Authors>Romain Flechner</Authors>
    <Description>Local-first MCP server for branch-aware C# code indexing, navigation and guarded editing.</Description>
    <PackageTags>mcp;model-context-protocol;dotnet-tool;code-indexing;roslyn</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rflechner/CodeSemantic4Llm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rflechner/CodeSemantic4Llm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodeSemantic4Llm.Application/CodeSemantic4Llm.Application.csproj" />
    <ProjectReference Include="../CodeSemantic4Llm.Analysis.CSharp/CodeSemantic4Llm.Analysis.CSharp.csproj" />
    <ProjectReference Include="../CodeSemantic4Llm.Configuration.Yaml/CodeSemantic4Llm.Configuration.Yaml.csproj" />
    <ProjectReference Include="../CodeSemantic4Llm.Infrastructure.Workspace/CodeSemantic4Llm.Infrastructure.Workspace.csproj" />
    <ProjectReference Include="../CodeSemantic4Llm.Persistence.Sqlite/CodeSemantic4Llm.Persistence.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Dashboard/index.html" LogicalName="CodeSemantic4Llm.Dashboard.Index" />
  </ItemGroup>
</Project>
