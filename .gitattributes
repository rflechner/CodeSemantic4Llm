# Normalize line endings so raw string literals in tests do not depend on the checkout.
# Git stores text as LF; every working tree receives LF, including on Windows.
* text=auto eol=lf

*.png binary

# Install the executable driver locally with: codesemantic4llm setup-git .
.codesemantic4llm/summaries/** merge=codesemantic-summary text eol=lf
